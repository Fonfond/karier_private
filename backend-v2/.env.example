# Karier GIS API — Спринт 1 (локальное окружение)
ENV=dev
DEBUG=true

# База: используем отдельные схемы auth/audit в общей БД карьера,
# чтобы не пересекаться с прототипом (public.users и т.д.)
DATABASE_URL=postgresql+psycopg://karier_user:Df492357816@127.0.0.1:5432/karier_db

# ОБЯЗАТЕЛЬНО заменить в prod: минимум 32 случайных символа
SECRET_KEY=dev-only-secret-change-me-karier-2026

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Стенд без Telegram-бота: код печатается в консоль и возвращается в ответе
EXPOSE_OTP_CODE=true
CONSOLE_NOTIFICATIONS=true
