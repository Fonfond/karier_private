# Karier GIS API — пример окружения (Спринты 1–7)
# Скопируйте в .env и заполните значения

# --- приложение ---
ENV=dev                      # dev | staging | prod
DEBUG=true
APP_NAME=Karier GIS API

# --- база данных (PostgreSQL 16+) ---
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/karier_db
DB_ECHO=false
DB_POOL_SIZE=5

# --- безопасность ---
# В продакшене: минимум 32 случайных символа, НЕ значение по умолчанию
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=60

# В продакшене обязательно true (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Домены фронтенда через запятую
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- лимиты ---
RATE_LIMIT_LOGIN_PER_MINUTE=50
RATE_LIMIT_REGISTER_PER_HOUR=100
MAX_FAILED_ATTEMPTS=5
# Для стенда: true — OTP печатается в консоль и возвращается в ответе
EXPOSE_OTP_CODE=true
CONSOLE_NOTIFICATIONS=true

# --- документы ---
DOCUMENTS_DIR=var/documents
MAX_DOCUMENT_MB=25
DOCUMENT_URL_TTL_MIN=30

# --- хранилище медиа ---
# auto: vercel_blob при наличии BLOB_READ_WRITE_TOKEN, иначе local
STORAGE_BACKEND=auto
MEDIA_DIR=var/media
MAX_PHOTO_MB=15
MEDIA_URL_TTL_MIN=120

# Vercel Blob (продакшен на Vercel)
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE=

# --- отчёты ---
EXPORT_URL_TTL_MIN=30
# Публичный адрес фронтенда — для QR в паспорте объекта
PUBLIC_BASE_URL=http://localhost:5174
# Путь к TTF с кириллицей (если пусто — ищем в системе: Segoe UI, DejaVu, Liberation)
PDF_FONT_PATH=
