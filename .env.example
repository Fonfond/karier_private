# Пример конфигурации стека «Карьер» для Docker Compose.
# Скопируйте в .env (он в .gitignore и в образы не попадает) и заполните значения.
# Реальных секретов здесь нет — только заглушки.

# --- compose: база и порт сайта ---
POSTGRES_USER=karier_user
POSTGRES_PASSWORD=__ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ__
POSTGRES_DB=karier_db
# сайт будет доступен на http://<host>:8080
WEB_PORT=8080

# --- приложение ---
ENV=prod
SECRET_KEY=__ЗАМЕНИТЕ_НА_32+_СЛУЧАЙНЫХ_СИМВОЛА__
DEBUG=false
APP_NAME=Karier GIS API
API_WORKERS=1

# --- токены и cookie ---
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=60
# в prod за HTTPS обязательно true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Домены фронтенда через запятую (например, https://karier.example.ru)
CORS_ORIGINS=
# Публичный адрес сайта — для QR в паспорте объекта
PUBLIC_BASE_URL=http://localhost:8080

# --- безопасность / лимиты ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20
MAX_FAILED_ATTEMPTS=5
# OTP только вручную через админку (S-5): в prod true запрещён
EXPOSE_OTP_CODE=false
CONSOLE_NOTIFICATIONS=false
# IP/CIDR reverse-proxy, которым доверяем X-Forwarded-For (через запятую).
# В compose запросы приходят от nginx — укажите его адрес/подсеть или оставьте пусто
# и полагайтесь на X-Real-IP настройки nginx.
TRUSTED_PROXIES=

# --- файлы ---
DOCUMENTS_DIR=var/documents
MAX_DOCUMENT_MB=25
DOCUMENT_URL_TTL_MIN=30
MEDIA_DIR=var/media
MAX_PHOTO_MB=15
MEDIA_URL_TTL_MIN=120
# auto | local (для compose достаточно local: файлы в томах)
STORAGE_BACKEND=local
EXPORT_URL_TTL_MIN=30
PDF_FONT_PATH=
